# Whitelist: exclude everything, then re-include only what the image needs.
*

!docker/
docker/*
!docker/requirements-server.txt
!src/
**/__pycache__
**/*.pyc

!models/
models/*
!models/best_churn_model_bundle.pkl

!reports/
reports/*
!reports/metrics.json
!reports/figures/
!reports/figures/eda/
!reports/figures/eda/*.png
!reports/figures/model/
!reports/figures/model/*.png

!data/
data/*
!data/processed/
data/processed/*
!data/processed/cleaned_customer_data.csv
